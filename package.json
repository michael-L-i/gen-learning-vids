{
  "name": "lesson-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal video learning library, powered by your local coding agent.",
  "bin": {
    "learnvid": "./bin/learnvid.js"
  },
  "scripts": {
    "dev": "node bin/learnvid.js serve --dev",
    "build": "vite build",
    "start": "node bin/learnvid.js serve --open",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "desktop": "electron desktop/main.cjs",
    "desktop:package": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "skill:codex": "node scripts/install-skill.js codex",
    "skill:claude": "node scripts/install-skill.js claude",
    "format": "prettier --write src server bin desktop tests scripts",
    "test:ui": "playwright test tests/ui.spec.js --workers=1",
    "build:icon": "node scripts/build-icon.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@huggingface/transformers": "^3.8.1",
    "@rdkit/rdkit": "^2026.3.6",
    "animejs": "^4.5.0",
    "d3-geo": "^3.1.1",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "elkjs": "^0.12.0",
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "htmlparser2": "^12.0.0",
    "jsxgraph": "^1.13.3",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.468.0",
    "mathjax-full": "^3.2.2",
    "molstar": "^5.11.0",
    "openseadragon": "6.1.1",
    "playwright": "^1.63.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "svg-path-properties": "2.1.0",
    "three": "^0.186.0",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.6.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "build": {
    "appId": "dev.lessonlibrary.app",
    "productName": "Lesson Library",
    "asar": true,
    "files": [
      "dist/**",
      "server/**",
      "plugins/lesson-library/skills/lesson-library/references/teaching.md",
      "!**/__pycache__/**",
      "bin/**",
      "desktop/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/phonemizer/**",
      "node_modules/kokoro-js/voices/**"
    ]
  },
  "author": "Lesson Library contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/michael-L-i/gen-learning-vids.git"
  }
}
