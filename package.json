{
  "name": "lesson-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal video learning library, powered by your local coding agent.",
  "bin": {
    "learnvid": "./bin/learnvid.js"
  },
  "scripts": {
    "dev": "node bin/learnvid.js serve --dev",
    "build": "vite build",
    "start": "node bin/learnvid.js serve --open",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "desktop": "electron desktop/main.cjs",
    "desktop:package": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.6.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "dev.lessonlibrary.app",
    "productName": "Lesson Library",
    "asar": true,
    "files": [
      "dist/**",
      "server/**",
      "bin/**",
      "desktop/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg"
    },
    "directories": {
      "output": "release"
    }
  }
}
